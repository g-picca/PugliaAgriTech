# Template per infrastructure/.env (file reale, non versionato: vedi
# .gitignore). Copiato automaticamente da 'scripts/start.sh' se
# infrastructure/.env non esiste ancora.
#
# Credenziali di sviluppo/dimostrazione, non di produzione: vedi la nota di
# sicurezza nel riepilogo di tesi (sezione 11.5) sul perche' in questo
# progetto didattico sono valori fissi e riproducibili invece che segreti
# generati ad hoc.

# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=agritech_db

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KC_DB_URL=jdbc:postgresql://postgres:5432/agritech_db
KC_DB_USERNAME=keycloak_admin
KC_DB_PASSWORD=keycloak_admin

# RabbitMQ
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=admin
